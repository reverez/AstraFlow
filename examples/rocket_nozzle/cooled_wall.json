{
  "problem": "rocket_nozzle",
  "gas": {
    "gamma": 1.4,
    "gas_constant": 287.0,
    "prandtl": 0.72,
    "viscosity": 1.716e-05,
    "viscosity_model": "sutherland",
    "reference_temperature": 273.15,
    "sutherland_temperature": 110.4
  },
  "geometry": {
    "chamber_radius": 0.006,
    "chamber_length": 0.03,
    "throat_radius": 0.0045,
    "contraction_length": 0.06,
    "exit_radius": 0.00675,
    "expansion_length": 0.12
  },
  "mesh": {
    "nx": 128,
    "nr": 32
  },
  "boundary_conditions": {
    "P0": 2000000,
    "T0": 2800,
    "back_pressure": 101325,
    "wall": "no_slip",
    "wall_temperature": 600
